[Unit]
Description=MAGI display — local web server
Documentation=https://github.com/angusmaul/magi-display
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__MAGI_HOME__/display
# Bound to loopback on purpose: the kiosk browser is the only consumer.
# Serving over http (not file://) is what lets the page fetch data.json —
# a file:// origin is opaque and the fetch is blocked as cross-origin.
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
